# App
PORT=3000
NODE_ENV=development

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=nestjs_practice
# SSL chỉ áp dụng khi NODE_ENV=production (vd. Render managed Postgres).
# DB_SSL_CA=          # nội dung PEM của CA (dùng "\n" thay cho xuống dòng)
# DB_SSL_REJECT_UNAUTHORIZED=true   # chỉ set "false" nếu chấp nhận rủi ro MITM

# JWT
JWT_ACCESS_SECRET=secret_key_change_in_production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=secret_key_change_in_production
JWT_REFRESH_EXPIRES_IN=7d

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
